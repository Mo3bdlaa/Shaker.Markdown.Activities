<!--
  The activity icons.

  Studio looks a DrawingBrush up by the key "<ActivityName>Icon" when it draws an activity in the
  Activities panel and on the canvas, so the keys here have to match the activity type names exactly. This
  file is the one definition of them: Glyphs.cs loads the brushes from here rather than building a second
  set in code.

  Every icon is a document page with an accent mark saying what the activity does to it, so the pack reads
  as one family while each activity is still told apart at a glance. The note keeps the Markdown mark
  itself, since it is the one activity that shows a document rather than converting one.

  The transparent square in each icon is load-bearing: it fixes the bounds at 16x16 so that Uniform stretch
  scales every icon identically. Without it an icon with a smaller mark would be drawn larger.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <DrawingBrush x:Key="MarkdownNoteIcon" Stretch="Uniform">
    <DrawingBrush.Drawing>
      <DrawingGroup>
      <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
      <GeometryDrawing>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="1.5,3.5,13,9" RadiusX="1.6" RadiusY="1.6" />
        </GeometryDrawing.Geometry>
        <GeometryDrawing.Pen>
          <Pen Brush="#FF5A6B7A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M4,10 V6 L6,8.5 L8,6 V10">
        <GeometryDrawing.Pen>
          <Pen Brush="#FF1F6FB2" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
      <GeometryDrawing Geometry="M11,6 V9.5 M9.5,8.5 L11,10 L12.5,8.5">
        <GeometryDrawing.Pen>
          <Pen Brush="#FF1F6FB2" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

