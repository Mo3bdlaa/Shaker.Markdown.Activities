<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows only, but not design time: these two activities put a window on screen and print, so they are
      what a Robot runs. Two targets, one for each generation of Studio, and the outputs are injected into
      the one package beside the portable activities rather than shipped as a package of their own.
    -->
    <TargetFrameworks>net461;net6.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Shaker.Markdown.Activities.Windows</RootNamespace>
    <AssemblyName>Shaker.Markdown.Activities.Windows</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      A .NET project resolves its NuGet assemblies from the package cache through deps.json and does not
      copy them to bin. This package has to carry WebView2's assemblies beside the assemblies that use them,
      so they have to be somewhere to copy from. Harmless for .NET Framework, which copies them anyway.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net461'">
    <!-- WebView2's assets floor at net462; see the note in Shaker.Markdown.Activities.csproj. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile time only. Both of these already travel in the package these activities ship inside. -->
    <ProjectReference Include="..\Shaker.Markdown.Activities\Shaker.Markdown.Activities.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Shaker.Markdown.Core\Shaker.Markdown.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Carried rather than depended on, like everything else Windows-specific here: a cross-platform project
      installing the pack has no use for WebView2 and should not have it restored into its dependencies.
      The assemblies travel beside these activities instead.
    -->
    <!-- 1.0.2478.35 rather than the newest. Later releases dropped the .NET Framework assets, and
      this package has to serve a Windows-legacy project as well as a modern one from the same source. It
      carries everything used here: PrintToPdfAsync, the print settings, and the virtual host mapping. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2478.35" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Activities" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0-windows'">
    <PackageReference Include="UiPath.Workflow" Version="6.0.0-20240401-07" PrivateAssets="all" />
  </ItemGroup>

</Project>
