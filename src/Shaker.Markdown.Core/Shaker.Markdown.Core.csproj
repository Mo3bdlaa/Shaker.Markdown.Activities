<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 so that one build of the engine serves every consumer here: the Windows-legacy
      activities on .NET Framework, the cross-platform ones on .NET, the WPF designers and the tests.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Shaker.Markdown.Core</RootNamespace>
    <AssemblyName>Shaker.Markdown.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
