<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net461            => UiPath "Windows - Legacy" projects
      net6.0-windows    => UiPath "Windows" projects, and what the designers ship with
      net6.0            => the frameworkless fallback, for cross-platform projects and a host that
                           resolves without the Windows flavour

      All three, which is the layout Shaker.SQLLiteDB.Activities ships and Studio installs happily. This
      package previously offered net461 and net6.0 only, with the designers in lib/net6.0 — and a Studio
      "Windows" project resolves lib/net6.0-windows7.0, so it never loaded them. That is what put the
      activities in a folder named after the assembly instead of their own, and left them without icons.
    -->
    <TargetFrameworks>net461;net6.0;net6.0-windows</TargetFrameworks>
    <!-- The designers and the Windows activities are WPF; building them from Linux needs this switch. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Shaker.Markdown.Activities</RootNamespace>
    <AssemblyName>Shaker.Markdown.Activities</AssemblyName>
    <AssemblyTitle>Shaker Markdown Activities</AssemblyTitle>
    <PackageId>Shaker.Markdown.Activities</PackageId>
    <Title>Shaker Markdown Activities</Title>
    <Description>Render Markdown inside UiPath. Document a workflow with a Markdown note that Studio draws as a formatted document on the canvas — from the note itself, from the activity's annotation, or from a .md file in the project — and convert Markdown to HTML, plain text, a DataTable or a PDF at run time.</Description>
    <PackageTags>UiPath;RPA;activities;markdown;documentation;readme;html;pdf;datatable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReleaseNotes>Shaker Markdown Activities: a Markdown Note that renders on the Studio canvas and reads its own annotation or a .md file in the project, plus Markdown To HTML, Markdown To Text, Read Markdown File, Get Markdown Outline, Get DataTable From Markdown, and — on Windows — Show Markdown and Markdown To PDF. Every activity appears under Markdown in the Activities panel.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The engine travels inside this package rather than as a separate dependency, so that installing one
      .nupkg into Studio or Orchestrator is enough to get a working activity pack. PrivateAssets keeps the
      project reference itself out of the package metadata; the target below puts the assembly in.
    -->
    <ProjectReference Include="..\Shaker.Markdown.Core\Shaker.Markdown.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Markdig is the one real dependency, and it is declared rather than embedded: it is somebody else's
      library under its own licence, and a consuming project that already has it should end up with one copy
      rather than two.

      It also matters that the package keeps a <dependencies> element at all. Studio reads the target
      framework groups in there to decide which project types the package supports, and a package with no
      element is reported as compatible with nothing.
    -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <!--
    Markdig on .NET Framework resolves to its netstandard2.0 assets, which carry System.Memory and the
    three polyfills behind it. Those packages declare net462 as their floor, and a Windows-legacy project
    is net461, so NuGet warns on every one of them. The warning is advisory rather than real: Studio's
    legacy projects run on whatever .NET Framework the machine has, which on any supported Windows is
    4.7.2 or later, and the polyfills load there. Silenced deliberately, not by accident.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net461'">
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Pinned rather than left transitive so the version that ships is the one that was tested. -->
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <Reference Include="System.Activities" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net461'">
    <!--
      Compile time only: Studio and the Robot bring their own workflow runtime, and PrivateAssets keeps this
      out of the package's dependencies so none of it lands in the consuming project.

      The version matters more than it looks. This must be a build UiPath actually ships, from their official
      feed, because the assembly version of System.Activities is what the activities are compiled to ask the
      host for. The UiPath.Workflow packages on nuget.org carry System.Activities 6.0.3.0, which no Studio
      has; the runtime resolves assemblies forward but never backward, so a project on the shipped 6.0.0.0
      fails to load them with "Could not load file or assembly 'System.Activities, Version=6.0.3.0'".
    -->
    <PackageReference Include="UiPath.Workflow" Version="6.0.0-20240401-07" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Shown beside the package in Studio's package manager and on the Marketplace listing. -->
    <None Include="package-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The engine, beside the activities, in every lib folder. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeMarkdownCore</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="IncludeMarkdownCore">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Shaker.Markdown.Core.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Shaker.Markdown.Core.xml" Condition="Exists('$(OutputPath)Shaker.Markdown.Core.xml')" />
    </ItemGroup>
  </Target>

  <!--
    The WPF assemblies: the designers, the two activities that put a window on screen, and the browser they
    render through. They go into the two Windows lib folders only — lib/net6.0 is the frameworkless fallback
    and must not carry WPF, or a cross-platform robot would be asked to load it.

    Referenced by path rather than as ProjectReferences because those projects reference this one, and NuGet
    will not allow that circle. Build the solution before packing; the target below says so if you did not.
  -->
  <PropertyGroup>
    <LegacyDesign>$(MSBuildThisFileDirectory)..\Shaker.Markdown.Activities.Design\bin\$(Configuration)\net461\</LegacyDesign>
    <ModernDesign>$(MSBuildThisFileDirectory)..\Shaker.Markdown.Activities.Design\bin\$(Configuration)\net6.0-windows\</ModernDesign>
    <LegacyWindows>$(MSBuildThisFileDirectory)..\Shaker.Markdown.Activities.Windows\bin\$(Configuration)\net461\</LegacyWindows>
    <ModernWindows>$(MSBuildThisFileDirectory)..\Shaker.Markdown.Activities.Windows\bin\$(Configuration)\net6.0-windows\</ModernWindows>
    <LegacyWindowsDesign>$(MSBuildThisFileDirectory)..\Shaker.Markdown.Activities.Windows.Design\bin\$(Configuration)\net461\</LegacyWindowsDesign>
    <ModernWindowsDesign>$(MSBuildThisFileDirectory)..\Shaker.Markdown.Activities.Windows.Design\bin\$(Configuration)\net6.0-windows\</ModernWindowsDesign>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows - Legacy -->
    <None Include="$(LegacyDesign)Shaker.Markdown.Activities.Design.dll" Pack="true" PackagePath="lib/net461/" Visible="false" />
    <None Include="$(LegacyWindows)Shaker.Markdown.Activities.Windows.dll" Pack="true" PackagePath="lib/net461/" Visible="false" />
    <None Include="$(LegacyWindowsDesign)Shaker.Markdown.Activities.Windows.Design.dll" Pack="true" PackagePath="lib/net461/" Visible="false" />
    <None Include="$(LegacyWindows)Microsoft.Web.WebView2.Core.dll" Pack="true" PackagePath="lib/net461/" Visible="false" />
    <None Include="$(LegacyWindows)Microsoft.Web.WebView2.Wpf.dll" Pack="true" PackagePath="lib/net461/" Visible="false" />
    <None Include="$(LegacyWindows)runtimes\win-x64\native\WebView2Loader.dll" Pack="true" PackagePath="lib/net461/" Visible="false" />

    <!-- Windows -->
    <None Include="$(ModernDesign)Shaker.Markdown.Activities.Design.dll" Pack="true" PackagePath="lib/net6.0-windows7.0/" Visible="false" />
    <None Include="$(ModernWindows)Shaker.Markdown.Activities.Windows.dll" Pack="true" PackagePath="lib/net6.0-windows7.0/" Visible="false" />
    <None Include="$(ModernWindowsDesign)Shaker.Markdown.Activities.Windows.Design.dll" Pack="true" PackagePath="lib/net6.0-windows7.0/" Visible="false" />
    <None Include="$(ModernWindows)Microsoft.Web.WebView2.Core.dll" Pack="true" PackagePath="lib/net6.0-windows7.0/" Visible="false" />
    <None Include="$(ModernWindows)Microsoft.Web.WebView2.Wpf.dll" Pack="true" PackagePath="lib/net6.0-windows7.0/" Visible="false" />
    <None Include="$(ModernWindows)runtimes\win-x64\native\WebView2Loader.dll" Pack="true" PackagePath="lib/net6.0-windows7.0/" Visible="false" />
  </ItemGroup>

  <!--
    A missing file above is skipped silently by pack, which would ship a package that installs and then does
    nothing visible in Studio. Say so instead.
  -->
  <Target Name="WarnOnMissingWindowsAssets" BeforeTargets="GenerateNuspec">
    <Warning Condition="!Exists('$(ModernDesign)Shaker.Markdown.Activities.Design.dll')"
             Text="The .NET build of the designers was not found at $(ModernDesign). A Windows project would install this package and show no icons, no Markdown folder and no rendered note. Build the solution before packing." />
    <Warning Condition="!Exists('$(LegacyDesign)Shaker.Markdown.Activities.Design.dll')"
             Text="The .NET Framework build of the designers was not found at $(LegacyDesign), so Windows-legacy projects will show the stock designers. Build the solution before packing." />
    <Warning Condition="!Exists('$(ModernWindows)Shaker.Markdown.Activities.Windows.dll')"
             Text="The .NET build of the Windows activities was not found at $(ModernWindows), so Show Markdown and Markdown To PDF will be missing. Build the solution before packing." />
    <Warning Condition="!Exists('$(ModernWindows)Microsoft.Web.WebView2.Core.dll')"
             Text="WebView2 was not found at $(ModernWindows), so Show Markdown and Markdown To PDF would fail at run time. Build the solution before packing." />
  </Target>

</Project>
