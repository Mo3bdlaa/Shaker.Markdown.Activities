<Project>

  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Mohamed Shaker</Authors>
    <Company>Mohamed Shaker</Company>
    <Product>Shaker.Markdown.Activities</Product>
    <Copyright>Copyright (c) Mohamed Shaker</Copyright>
    <PackageProjectUrl>https://github.com/Mo3bdlaa/Shaker.Markdown.Activities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mo3bdlaa/Shaker.Markdown.Activities</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

</Project>
